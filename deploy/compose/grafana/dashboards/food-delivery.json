    {
      "id": 5,
      "title": "HTTP: запросов в секунду",
      "type": "timeseries",
      "description": "Прикладной HTTP-трафик; /metrics, /healthz, /readyz исключены. gRPC-запросы здесь не учитываются.",
      "datasource": {
        "type": "prometheus",
        "uid": "food-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "food-prometheus"
          },
          "expr": "sum by(service) (rate(food_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
