  "panels": [
    {
      "id": 1,
      "title": "Доступность /metrics",
      "type": "stat",
      "description": "UP означает успешный сбор /metrics; доступность бизнес-зависимостей проверяется отдельно.",
      "datasource": {
        "type": "prometheus",
        "uid": "food-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "food-prometheus"
          },
          "expr": "up{job=~\"orders|catalog|notifications|balancer\"}",
          "legendFormat": "{{job}} / {{instance}}",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "Нет данных",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
